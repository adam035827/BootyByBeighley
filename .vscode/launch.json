{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Run Application",
      "configurations": ["Backend", "Frontend (ng serve)"],
      "stopAll": true,
      "presentation": { "order": 1, "group": "" }
    }
  ],
  "configurations": [
    {
      "name": "Backend",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "prepare: backend",
      "program": "${workspaceFolder}/backend/src/BootyByBeighley.Api/bin/Debug/net10.0/BootyByBeighley.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/src/BootyByBeighley.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5118"
      },
      "postDebugTask": "kill: all",
      "presentation": { "hidden": true, "group": "compound" }
    },
    {
      "name": "Frontend (ng serve)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "userDataDir": true,
      "preLaunchTask": "serve: frontend",
      "presentation": { "hidden": true, "group": "compound" }
    }
  ]
}
